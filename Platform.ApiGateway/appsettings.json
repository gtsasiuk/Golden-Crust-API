{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "auth": {
        "ClusterId": "auth",
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/api/auth/{**catch-all}" }
      },
      "users": {
        "ClusterId": "auth",
        "AuthorizationPolicy": "authenticated",
        "Match": { "Path": "/api/users/{**catch-all}" }
      },
      "aggregator": {
        "ClusterId": "aggregator",
        "Order": 1,
        "AuthorizationPolicy": "authenticated",
        "Match": { "Path": "/api/aggregator/{**catch-all}" }
      },
      "orders": {
        "ClusterId": "orders",
        "AuthorizationPolicy": "authenticated",
        "Match": { "Path": "/api/orders/{**catch-all}" }
      },
      "customers": {
        "ClusterId": "orders",
        "AuthorizationPolicy": "authenticated",
        "Match": { "Path": "/api/customers/{**catch-all}" }
      },
      "payments": {
        "ClusterId": "payments",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/payments/{**catch-all}"
        }
      },
      "menu-items-read": {
        "ClusterId": "catalog",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/api/menu-items/{**catch-all}",
          "Methods": [ "GET", "HEAD", "OPTIONS" ]
        }
      },
      "menu-items-write": {
        "ClusterId": "catalog",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/menu-items/{**catch-all}",
          "Methods": [ "POST", "PUT", "PATCH", "DELETE" ]
        }
      },
      "categories-read": {
        "ClusterId": "catalog",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/api/categories/{**catch-all}",
          "Methods": [ "GET", "HEAD", "OPTIONS" ]
        }
      },
      "categories-write": {
        "ClusterId": "catalog",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/categories/{**catch-all}",
          "Methods": [ "POST", "PUT", "PATCH", "DELETE" ]
        }
      },
      "tags-read": {
        "ClusterId": "catalog",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/api/tags/{**catch-all}",
          "Methods": [ "GET", "HEAD", "OPTIONS" ]
        }
      },
      "tags-write": {
        "ClusterId": "catalog",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/tags/{**catch-all}",
          "Methods": [ "POST", "PUT", "PATCH", "DELETE" ]
        }
      },
      "reviews-read": {
        "ClusterId": "reviews",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/api/reviews/{**catch-all}",
          "Methods": [ "GET", "HEAD", "OPTIONS" ]
        }
      },
      "reviews-write": {
        "ClusterId": "reviews",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/reviews/{**catch-all}",
          "Methods": [ "POST", "PUT", "PATCH", "DELETE" ]
        }
      }
    },
    "Clusters": {
      "auth": { "Destinations": { "d1": { "Address": "http://auth-api" } } },
      "aggregator": { "Destinations": { "d1": { "Address": "http://aggregator" } } },
      "orders": { "Destinations": { "d1": { "Address": "http://orders-api" } } },
      "catalog": { "Destinations": { "d1": { "Address": "http://catalog-api" } } },
      "reviews": { "Destinations": { "d1": { "Address": "http://reviews-api" } } }
    }
  }
}