// Golden Crust | CATALOG (SQL Server + EF Core) | вставте на https://dbdiagram.io -> Export (PNG/SVG)

Table MenuCategories {
  Id bigint [pk, increment]
  Name nvarchar(100) [not null, unique]
  SortOrder int [not null, default: 0]
  Note: 'Audit: CreatedAt, CreatedBy, UpdatedAt, UpdatedBy, IsDeleted, RowVersion'
}

Table MenuItems {
  Id bigint [pk, increment]
  CategoryId bigint [not null]
  Name nvarchar(200) [not null, note: 'UNIQUE серед IsDeleted = 0']
  Price decimal(10,2) [not null, note: 'CHECK Price > 0']
  IsAvailable bit [not null, default: 1]
  Note: 'Audit як у MenuCategories. ВЛАСНИК даних про страви для Orders і Reviews'
  indexes {
    (CategoryId, Name) [name: 'IX_MenuItems_CategoryId_Name', note: 'INCLUDE (Price, IsAvailable) WHERE IsDeleted = 0']
    Name [unique, name: 'UX_MenuItems_Name', note: 'WHERE IsDeleted = 0']
  }
}

Table MenuItemDetails {
  MenuItemId bigint [pk, note: 'PK = FK (1:1)']
  Description nvarchar(2000)
  Ingredients nvarchar(1000)
  WeightGrams int [note: 'CHECK > 0']
  Calories int [note: 'CHECK >= 0']
}

Table MenuItemImages {
  Id bigint [pk, increment]
  MenuItemId bigint [not null]
  Url nvarchar(500) [not null]
  AltText nvarchar(200)
  IsPrimary bit [not null, default: 0]
  SortOrder int [not null, default: 0]
  indexes {
    (MenuItemId, SortOrder) [name: 'IX_MenuItemImages_MenuItemId_SortOrder']
    MenuItemId [unique, name: 'UX_MenuItemImages_OnePrimary', note: 'WHERE IsPrimary = 1']
  }
}

Table Tags {
  Id bigint [pk, increment]
  Name nvarchar(50) [not null, unique]
}

Table MenuItemTags {
  MenuItemId bigint [not null]
  TagId bigint [not null]
  AddedAt datetime2 [not null, note: 'власне поле зв''язку M:N']
  indexes {
    (MenuItemId, TagId) [pk]
    (TagId, MenuItemId) [name: 'IX_MenuItemTags_TagId_MenuItemId']
  }
}

Ref: MenuItems.CategoryId > MenuCategories.Id                    // 1:N
Ref: MenuItemDetails.MenuItemId - MenuItems.Id [delete: cascade] // 1:1
Ref: MenuItemImages.MenuItemId > MenuItems.Id [delete: cascade]  // 1:N
Ref: MenuItemTags.MenuItemId > MenuItems.Id [delete: cascade]    // M:N
Ref: MenuItemTags.TagId > Tags.Id [delete: cascade]              // M:N
