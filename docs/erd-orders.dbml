// Golden Crust | ORDERS (SQL Server) | вставте на https://dbdiagram.io -> Export (PNG/SVG)
// Аудитні колонки (CreatedAt, CreatedBy, UpdatedAt, UpdatedBy, IsDeleted, RowVersion) описані в DDL.

Table Customers {
  Id bigint [pk, increment]
  Email nvarchar(256) [not null, unique]
  FullName nvarchar(200) [not null]
  Phone nvarchar(30)
  Note: 'Audit: CreatedAt, CreatedBy, UpdatedAt, UpdatedBy, IsDeleted, RowVersion'
}

Table MenuItems {
  Id bigint [pk, note: 'той самий Id, що в БД Catalog (НЕ identity, без FK між БД)']
  Name nvarchar(200) [not null]
  Price decimal(10,2) [not null, note: 'CHECK Price > 0']
  IsAvailable bit [not null, default: 1]
  Note: 'ЛОКАЛЬНА КОПІЯ довідника Catalog. Власник: Catalog. Audit як у Customers'
}

Table Orders {
  Id bigint [pk, increment]
  CustomerId bigint [not null]
  Status nvarchar(30) [not null, default: 'Placed', note: 'CHECK: Placed|Accepted|Cooking|ReadyForDelivery|Delivering|Delivered|Cancelled']
  TotalAmount decimal(10,2) [not null, default: 0]
  OrderDate datetime2 [not null]
  Note: 'Audit як у Customers'
  indexes {
    (CustomerId, OrderDate) [name: 'IX_Orders_CustomerId_OrderDate', note: 'INCLUDE (Status, TotalAmount) WHERE IsDeleted = 0']
    (Status, OrderDate) [name: 'IX_Orders_Status_OrderDate_Active', note: 'filtered: активні замовлення']
  }
}

Table OrderDetails {
  OrderId bigint [pk, note: 'PK = FK (1:1)']
  DeliveryAddress nvarchar(400) [not null]
  DeliveryLat decimal(9,6)
  DeliveryLng decimal(9,6)
  Comment nvarchar(1000)
}

Table OrderItems {
  OrderId bigint [not null]
  MenuItemId bigint [not null]
  ProductName nvarchar(200) [not null, note: 'ЗНІМОК на момент замовлення']
  UnitPrice decimal(10,2) [not null, note: 'ЗНІМОК; CHECK > 0']
  Quantity int [not null, note: 'CHECK > 0']
  LineTotal decimal(10,2) [note: 'persisted computed: UnitPrice * Quantity']
  indexes {
    (OrderId, MenuItemId) [pk]
    MenuItemId [name: 'IX_OrderItems_MenuItemId']
  }
}

Table Payments {
  Id bigint [pk, increment]
  OrderId bigint [not null]
  Amount decimal(10,2) [not null]
  Status nvarchar(20) [not null, default: 'Pending', note: 'CHECK: Pending|Paid|Refunded|Cancelled']
  PaidAt datetime2
  TransactionRef nvarchar(100)
  Note: 'Audit як у Customers; UNIQUE (OrderId) WHERE Status не Cancelled/Refunded'
}

Table OrderStatusHistory {
  Id bigint [pk, increment]
  OrderId bigint [not null]
  FromStatus nvarchar(30)
  ToStatus nvarchar(30) [not null]
  ChangedAt datetime2 [not null]
  ChangedBy nvarchar(100)
  Note nvarchar(500)
  indexes {
    (OrderId, ChangedAt) [name: 'IX_OrderStatusHistory_OrderId_ChangedAt']
  }
}

Ref: Orders.CustomerId > Customers.Id                              // 1:N
Ref: OrderDetails.OrderId - Orders.Id [delete: cascade]           // 1:1
Ref: OrderItems.OrderId > Orders.Id [delete: cascade]             // M:N (Orders <-> MenuItems)
Ref: OrderItems.MenuItemId > MenuItems.Id                         // M:N
Ref: Payments.OrderId > Orders.Id                                 // 1:N
Ref: OrderStatusHistory.OrderId > Orders.Id [delete: cascade]     // 1:N
